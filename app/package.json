{
  "name": "command-center",
  "version": "1.0.0",
  "private": true,
  "description": "Mako — a one-click dark launcher tying together VSCode, GitHub, and parallel Claude/Codex/Gemini agents in isolated git worktrees.",
  "main": "main.js",
  "scripts": {
    "postinstall": "node ensure-electron-binary.js",
    "start": "electron .",
    "start:classic": "electron . --classic-layout",
    "start:dev": "electron . --dev-instance",
    "dockview:tripwire": "electron dockview-tripwire.js",
    "test": "node run-tests.js"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true
  },
  "author": "ABlueAI",
  "license": "MIT",
  "devDependencies": {
    "electron": "42.11.16"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@playwright/mcp": "0.0.84",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "7.0.4",
    "ipaddr.js": "2.5.0",
    "kokoro-js": "^1.2.1"
  }
}
